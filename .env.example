# --- Postgres Airflow Metadata ---
PG_USER=airflow
PG_PASSWORD=airflow
AF_DB=airflow

# --- Postgres Data Warehouse ---
DW_USER=dw_admin
DW_PASSWORD=dw_secure_password
DW_DB=lab_dw

# --- Airflow Core ---
FERNET_KEY=your_generated_fernet_key_here

# --- Metabase ---
MB_USER=admin
MB_PASS=password

# --- Connection URIs for Python Scripts ---
# Format: postgresql://user:password@host:port/dbname
# Format: mysql+pymysql://user:password@host:port/dbname
PG_CONN=postgresql://dw_admin:dw_secure_password@postgres-dw:5432/lab_dw
MYSQL_CONN=mysql+pymysql://legacy_user:legacy_pass@legacy_host:3306/legacy_db

# --- Paths ---
DBT_ROOT=/opt/airflow/dbt